# Silver Forged Gui — Global Demand Engine V1
# Copy this file to .env.local and fill in real values as needed.

# --- Demo Mode ---
# When true, the app runs entirely without an AI provider using a heuristic
# response. The UI clearly labels responses as "DEMO MODE · Sample response".
# Automatically enabled when no ANTHROPIC_API_KEY is set — local dev can leave
# this unset and still get real AI once a key is provided.
# Production (Vercel project randomplayx-engine) sets DEMO_MODE=false explicitly.
DEMO_MODE=false

# --- 文本 AI（Anthropic 协议）---
# 方式 A · 直连 Anthropic Claude：只填 ANTHROPIC_API_KEY。
# 方式 B · 智谱 GLM（当前生产配置）：另设 BASE_URL 并换模型名：
#   ANTHROPIC_BASE_URL=https://open.bigmodel.cn/api/anthropic
#   AI_MODEL=glm-4.7
# Server-side only; never exposed to the client.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=

# Model identifier for the Anthropic-protocol provider. Kept as an env var so
# it can be swapped without a code change. Default aligns with Claude Opus 4.7;
# production runs glm-4.7 via the BigModel-compatible endpoint above.
AI_MODEL=glm-4.7

# --- Tunables ---
AI_MAX_TOKENS=2400
AI_TIMEOUT_MS=45000

# --- Stage 6 · Dynamic Visual Layer ---
# Set to "false" to disable the global particle background (kill switch for
# debugging / performance testing). Any other value (or unset) leaves the
# layer enabled. prefers-reduced-motion is honored independently.
NEXT_PUBLIC_PARTICLE_EFFECT=true

# --- 效果图渲染（质感层生图）---
# IMAGE_PROVIDER=mock              确定性 SVG 章型占位图（无需 Key，流程可完整跑通）。
# IMAGE_PROVIDER=openai-gpt-image  推荐 — 以 public/seal-references/ 的真实印章照片
#                                  为参考图（images.edit），质感层继承实物石质
#                                  与刀工；印面文字由字体引擎后叠加，本层不出字。
IMAGE_PROVIDER=openai-gpt-image
OPENAI_API_KEY=

# 中转站 base URL（例：https://www.dmxapi.cn/v1）。
# ⚠️ 国内网络直连不到 api.openai.com——留空会一路挂到超时，UI 只显示
# 「效果图生成被打断」。用中转站时这一项是必填，不是可选。
OPENAI_BASE_URL=

# 生图模型名。官方端点用 gpt-image-2；中转站按其型号表填，
# 例如 DMXAPI 推荐 gpt-image-2-ssvip（更稳更快）。
# ⚠️ 各站开通型号不同：同一 key 上 gpt-image-2 可用而 gpt-image-1
# 返回 model_not_found 是常态——换站先用 /v1/images/generations 验型号。
IMAGE_MODEL=gpt-image-2

# 生图超时（毫秒）。必须 ≤ app/api/design-render/route.ts 的 maxDuration
# （当前 60s），否则线上函数先被平台杀掉，拿不到我们自己的错误信息。
# 实测：参考图编辑约 30s，quality 提高后更久。
IMAGE_TIMEOUT_MS=55000
# --- 成品独立站（Collection Shop）---
# 双路线中的"直接选购"线：顶栏「成品系列」与首页「直接选购成品」按钮
# 跳转的目标地址。填你们银饰独立站平台的正式域名（含 https://）。
# 未设置时按钮指向 "#" 占位，不发生真实跳转。
NEXT_PUBLIC_COLLECTION_URL=

# --- 3D 篆章展厅（外链独立 3D 站）---
# 首页 Act 3 幕内链接与页脚链接指向的独立 3D 印章展厅。
# 未设置（空值）时入口按钮整体隐藏；独立站上线后在此填入域名。
# 注意：值为不含查询参数的基础 URL（UTM 由各入口代码拼接）。
NEXT_PUBLIC_3D_SEAL_URL=