# 印可道 — AI 篆刻定制
# 复制为 .env.local；所有文件使用 UTF-8，密钥只放本地或服务端环境变量。

# true 强制使用规则模板；缺少所选文本服务的 Key 时也自动回退。
DEMO_MODE=false

# 文本 AI：bigmodel 使用智谱通用 API Key，不能以 Coding Plan Key 代替。
# 如继续使用 Anthropic 或其兼容服务，设置 TEXT_AI_PROVIDER=anthropic。
TEXT_AI_PROVIDER=bigmodel
BIGMODEL_API_KEY=
BIGMODEL_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
AI_MODEL=glm-4.7
AI_MAX_TOKENS=2400
AI_TIMEOUT_MS=45000

# 崇曦为默认字体；yishan 为应急回退。原始 OTF 与许可附件已入库。
SEAL_FONT_STACK=chongxi
# 仅需要自定义字体存放位置时填写绝对路径。
SEAL_CHONGXI_FONT_PATH=

# M8 文化匹配灰度开关；false 时保留原有静态文化引导。
SEAL_CULTURE_ENABLED=true
NEXT_PUBLIC_PARTICLE_EFFECT=true

# mock 无需密钥；openai-gpt-image 使用真实石料参考图生成质感层。
IMAGE_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_BASE_URL=
IMAGE_MODEL=gpt-image-2
# 单次生图超时 240s；app/api/design-render 的路由上限为 300s。
IMAGE_TIMEOUT_MS=240000

# 建模 / 4K 石料重贴图需要用户同意收费测试后才开启。
# false 仍可查询和复用已转存的模型。
MESHY_GENERATION_ENABLED=false
MESHY_API_KEY=
BLOB_READ_WRITE_TOKEN=
# 仅本地调试按实际代理端口填写，Vercel 直连不设置此项。
OUTBOUND_PROXY_URL=

# 独立 3D 篆章展厅外链；空值隐藏入口。
NEXT_PUBLIC_3D_SEAL_URL=
